// X-macro: REG(name, byte_offset, bit_width)
// byte_offset is the position in the IGNIL register address space.
// Sub-registers share the base offset of their parent; width selects the slice.

// 64-bit
REG("RAX",  0,   64)
REG("RCX",  8,   64)
REG("RDX",  16,  64)
REG("RBX",  24,  64)
REG("RSP",  32,  64)
REG("RBP",  40,  64)
REG("RSI",  48,  64)
REG("RDI",  56,  64)
REG("R8",   64,  64)
REG("R9",   72,  64)
REG("R10",  80,  64)
REG("R11",  88,  64)
REG("R12",  96,  64)
REG("R13",  104, 64)
REG("R14",  112, 64)
REG("R15",  120, 64)
REG("RIP",  128, 64)

// 32-bit (same base offset as 64-bit parent)
REG("EAX",  0,   32)
REG("ECX",  8,   32)
REG("EDX",  16,  32)
REG("EBX",  24,  32)
REG("ESP",  32,  32)
REG("EBP",  40,  32)
REG("ESI",  48,  32)
REG("EDI",  56,  32)
REG("R8D",  64,  32)
REG("R9D",  72,  32)
REG("R10D", 80,  32)
REG("R11D", 88,  32)
REG("R12D", 96,  32)
REG("R13D", 104, 32)
REG("R14D", 112, 32)
REG("R15D", 120, 32)

// R8-R15 word (16-bit) sub-registers
REG("R8W",  64,  16)
REG("R9W",  72,  16)
REG("R10W", 80,  16)
REG("R11W", 88,  16)
REG("R12W", 96,  16)
REG("R13W", 104, 16)
REG("R14W", 112, 16)
REG("R15W", 120, 16)

// R8-R15 byte (8-bit) sub-registers
REG("R8B",  64,  8)
REG("R9B",  72,  8)
REG("R10B", 80,  8)
REG("R11B", 88,  8)
REG("R12B", 96,  8)
REG("R13B", 104, 8)
REG("R14B", 112, 8)
REG("R15B", 120, 8)

// 16-bit
REG("AX",   0,   16)
REG("CX",   8,   16)
REG("DX",   16,  16)
REG("BX",   24,  16)
REG("SP",   32,  16)
REG("BP",   40,  16)
REG("SI",   48,  16)
REG("DI",   56,  16)

// 8-bit low
REG("AL",   0,   8)
REG("CL",   8,   8)
REG("DL",   16,  8)
REG("BL",   24,  8)
REG("SPL",  32,  8)
REG("BPL",  40,  8)
REG("SIL",  48,  8)
REG("DIL",  56,  8)

// 8-bit high (byte 1 of the 16-bit view: AH = bits [15:8] of AX)
REG("AH",   1,   8)
REG("CH",   9,   8)
REG("DH",   17,  8)
REG("BH",   25,  8)

// Flags - 1-byte slots, 1-bit semantics; offsets start at 136
REG("CF",   136, 8)
REG("PF",   137, 8)
REG("AF",   138, 8)
REG("ZF",   139, 8)
REG("SF",   140, 8)
REG("OF",   141, 8)
REG("DF",   142, 8)

// XMM0-XMM15: each 128-bit register is two 64-bit halves. XMMn (offset
// 143 + 8n) is bits 63:0 - the scalar-double lane every existing scalar
// lifter uses - and XMMnH (offset 271 + 8n) is bits 127:64. Packed SSE is
// lifted on the two halves; nothing in IGNIL has to be 128 bits wide.
// Bits above 127 (YMM/ZMM) are not modelled.
REG("XMM0",  143, 64)
REG("XMM1",  151, 64)
REG("XMM2",  159, 64)
REG("XMM3",  167, 64)
REG("XMM4",  175, 64)
REG("XMM5",  183, 64)
REG("XMM6",  191, 64)
REG("XMM7",  199, 64)
REG("XMM8",  207, 64)
REG("XMM9",  215, 64)
REG("XMM10", 223, 64)
REG("XMM11", 231, 64)
REG("XMM12", 239, 64)
REG("XMM13", 247, 64)
REG("XMM14", 255, 64)
REG("XMM15", 263, 64)
REG("XMM0H", 271, 64)
REG("XMM1H", 279, 64)
REG("XMM2H", 287, 64)
REG("XMM3H", 295, 64)
REG("XMM4H", 303, 64)
REG("XMM5H", 311, 64)
REG("XMM6H", 319, 64)
REG("XMM7H", 327, 64)
REG("XMM8H", 335, 64)
REG("XMM9H", 343, 64)
REG("XMM10H", 351, 64)
REG("XMM11H", 359, 64)
REG("XMM12H", 367, 64)
REG("XMM13H", 375, 64)
REG("XMM14H", 383, 64)
REG("XMM15H", 391, 64)

// Physical x87 stack storage. ST(i) is selected dynamically using FPTOP.
REG("FPU0", 400, 80)
REG("FPU0L", 400, 64)
REG("FPU0H", 408, 16)
REG("FPU1", 410, 80)
REG("FPU1L", 410, 64)
REG("FPU1H", 418, 16)
REG("FPU2", 420, 80)
REG("FPU2L", 420, 64)
REG("FPU2H", 428, 16)
REG("FPU3", 430, 80)
REG("FPU3L", 430, 64)
REG("FPU3H", 438, 16)
REG("FPU4", 440, 80)
REG("FPU4L", 440, 64)
REG("FPU4H", 448, 16)
REG("FPU5", 450, 80)
REG("FPU5L", 450, 64)
REG("FPU5H", 458, 16)
REG("FPU6", 460, 80)
REG("FPU6L", 460, 64)
REG("FPU6H", 468, 16)
REG("FPU7", 470, 80)
REG("FPU7L", 470, 64)
REG("FPU7H", 478, 16)
REG("FPTOP", 480, 8)
REG("FPTAG", 482, 16)
REG("FPCW", 484, 16)
REG("FPSW", 486, 16)
